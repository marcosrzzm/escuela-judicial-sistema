# Copiar a .env y ajustar. Nada de esto es secreto en el piloto local.
PHP_BIN=/Users/marcosrzm/Apps/onyx-dev/bin/php
MYSQL_DIR=/Users/marcosrzm/Apps/onyx-dev/mysql
MYSQL_PUERTO=3311
DB_HOST=127.0.0.1
DB_NOMBRE=escuela_judicial
DB_USUARIO=ej_app
DB_CONTRASENA=cambiar
API_PUERTO=8080
WEB_PUERTO=5173
# local permite el reinicio de la semilla y cookie sin Secure; en el hosting va "produccion".
ENTORNO=local
# Correo por Resend (invitaciones y restablecimiento). En el hosting van en ej-config.env, fuera de public_html.
# Sin RESEND_API_KEY no sale ningún correo; en local queda un archivo en seguridad/correos-dev/ con el enlace.
RESEND_API_KEY=
# Dirección verificada en Resend; el nombre visible ("Sistema escolar · Escuela Judicial") lo pone el sistema.
CORREO_REMITENTE=
# Dirección pública del sistema, sin diagonal final. Vacía en local: se usa http://localhost:WEB_PUERTO.
SITIO_URL=
